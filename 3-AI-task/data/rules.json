{
  "schema_version": "1.0",
  "description": "Правила экспертной системы выбора комнатного растения. Условия являются структурированным описанием логики; для исполнения нужен механизм вывода, понимающий указанные типы действий и ссылки на факты.",
  "value_conventions": {
    "unknown": "Неизвестное значение; не приравнивается к отрицательному ответу.",
    "pet_safety": [
      "toxic",
      "non_toxic",
      "unknown"
    ],
    "watering_frequency": [
      "редкий",
      "умеренный",
      "частый"
    ],
    "note": "Строковые значения должны точно совпадать с plants.json и questions.json."
  },
  "rules": [
    {
      "id": "R01",
      "group": "A",
      "description": "Уточнение неизвестного освещения",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.lighting",
            "operator": "==",
            "value": "unknown"
          }
        ]
      },
      "action": {
        "type": "ask_question",
        "question_id": "F-01"
      },
      "explanation": "Уровень освещения неизвестен, поэтому система запрашивает его у пользователя."
    },
    {
      "id": "R02",
      "group": "A",
      "description": "Уточнение предпочтительной частоты полива",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.watering_preference",
            "operator": "==",
            "value": "unknown"
          }
        ]
      },
      "action": {
        "type": "ask_question",
        "question_id": "F-02"
      },
      "explanation": "Система уточняет, как часто пользователь готов поливать растение."
    },
    {
      "id": "R03",
      "group": "A",
      "description": "Уточнение влажности воздуха",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.humidity",
            "operator": "==",
            "value": "unknown"
          }
        ]
      },
      "action": {
        "type": "ask_question",
        "question_id": "F-03"
      },
      "explanation": "Влажность помещения неизвестна, поэтому система задаёт дополнительный вопрос."
    },
    {
      "id": "R04",
      "group": "A",
      "description": "Уточнение наличия сквозняков",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.drafts",
            "operator": "==",
            "value": "unknown"
          }
        ]
      },
      "action": {
        "type": "ask_question",
        "question_id": "F-04"
      },
      "explanation": "Система уточняет, бывают ли в помещении сильные сквозняки."
    },
    {
      "id": "R05",
      "group": "A",
      "description": "Уточнение наличия домашних животных",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.pets",
            "operator": "==",
            "value": "unknown"
          }
        ]
      },
      "action": {
        "type": "ask_question",
        "question_id": "F-08"
      },
      "explanation": "Наличие животных влияет на проверку токсичности и физических рисков растения."
    },
    {
      "id": "R06",
      "group": "A",
      "description": "Проверка допустимости ответа",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "input.answer_valid",
            "operator": "==",
            "value": false
          }
        ]
      },
      "action": {
        "type": "repeat_question",
        "message": "Ответ не входит в допустимые значения. Пожалуйста, выберите один из предложенных вариантов."
      },
      "explanation": "Введённый ответ не соответствует списку допустимых значений вопроса."
    },
    {
      "id": "R07",
      "group": "B",
      "description": "Исключение по освещению",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.lighting",
            "operator": "==",
            "value": "слабое"
          },
          {
            "fact": "plant.lighting.tolerates_low",
            "operator": "==",
            "value": false
          }
        ]
      },
      "action": {
        "type": "set_fact",
        "fact": "candidate.excluded.light",
        "value": true
      },
      "explanation": "Растение не переносит слабое освещение, указанное пользователем."
    },
    {
      "id": "R08",
      "group": "B",
      "description": "Исключение при подтверждённой опасности для кошек",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.pets",
            "operator": "in",
            "value": [
              "кошка",
              "кошка и собака"
            ]
          },
          {
            "fact": "plant.pet_safety.cats",
            "operator": "==",
            "value": "toxic"
          }
        ]
      },
      "action": {
        "type": "set_fact",
        "fact": "candidate.excluded.safety",
        "value": true
      },
      "explanation": "В паспорте указана опасность растения для кошек."
    },
    {
      "id": "R09",
      "group": "B",
      "description": "Исключение при подтверждённой опасности для собак",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.pets",
            "operator": "in",
            "value": [
              "собака",
              "кошка и собака"
            ]
          },
          {
            "fact": "plant.pet_safety.dogs",
            "operator": "==",
            "value": "toxic"
          }
        ]
      },
      "action": {
        "type": "set_fact",
        "fact": "candidate.excluded.safety",
        "value": true
      },
      "explanation": "В паспорте указана опасность растения для собак."
    },
    {
      "id": "R10",
      "group": "B",
      "description": "Блокировка рекомендации при неизвестной безопасности для животных",
      "conditions": {
        "logic": "OR",
        "items": [
          {
            "logic": "AND",
            "items": [
              {
                "fact": "user.pets",
                "operator": "in",
                "value": [
                  "кошка",
                  "кошка и собака"
                ]
              },
              {
                "fact": "plant.pet_safety.cats",
                "operator": "==",
                "value": "unknown"
              }
            ]
          },
          {
            "logic": "AND",
            "items": [
              {
                "fact": "user.pets",
                "operator": "in",
                "value": [
                  "собака",
                  "кошка и собака"
                ]
              },
              {
                "fact": "plant.pet_safety.dogs",
                "operator": "==",
                "value": "unknown"
              }
            ]
          }
        ]
      },
      "action": {
        "type": "set_fact",
        "fact": "candidate.excluded.unknown_safety",
        "value": true
      },
      "explanation": "Безопасность растения для имеющегося у пользователя вида животного не установлена; система не рекомендует его как безопасное до уточнения."
    },
    {
      "id": "R11",
      "group": "B",
      "description": "Исключение из-за опасных колючек при возможном контакте с питомцем",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.pets",
            "operator": "!=",
            "value": "нет"
          },
          {
            "fact": "plant.pet_safety.physical_risk",
            "operator": "==",
            "value": "dangerous_spines"
          },
          {
            "fact": "user.pets_interest",
            "operator": "==",
            "value": "да"
          }
        ]
      },
      "action": {
        "type": "set_fact",
        "fact": "candidate.excluded.physical_risk",
        "value": true
      },
      "explanation": "Питомец проявляет интерес к растениям, а растение имеет опасные колючки."
    },
    {
      "id": "R12",
      "group": "B",
      "description": "Исключение растения при нарушении обязательного критерия",
      "conditions": {
        "logic": "OR",
        "items": [
          {
            "fact": "candidate.excluded.light",
            "operator": "==",
            "value": true
          },
          {
            "fact": "candidate.excluded.safety",
            "operator": "==",
            "value": true
          },
          {
            "fact": "candidate.excluded.unknown_safety",
            "operator": "==",
            "value": true
          },
          {
            "fact": "candidate.excluded.physical_risk",
            "operator": "==",
            "value": true
          }
        ]
      },
      "action": {
        "type": "set_fact",
        "fact": "candidate.eligible",
        "value": false
      },
      "explanation": "Растение нарушает хотя бы одно обязательное ограничение и не допускается к рекомендации."
    },
    {
      "id": "R13",
      "group": "C",
      "description": "Освещение соответствует предпочтениям растения",
      "conditions": {
        "logic": "AND",
        "items": [
          {
            "fact": "user.lighting",
            "operator": "==",
            "fact_ref": "plant.lighting.preferred"
