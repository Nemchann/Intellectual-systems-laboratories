      "name": "Совпадение предпочтения: цветущее",
      "calculation": "evaluate_appearance_branch",
      "depends_on": [
        "e07",
        "plants.{{plant_id}}.appearance",
        "compatibility.{{plant_id}}.appearance.flowering"
      ],
      "branch_value": "flowering"
    },
